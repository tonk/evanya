{
  app: {
    // Bundle name; build-hap.sh can override it with BUNDLE=...
    bundleName: 'com.evanya.mail',
    vendor: 'Flectar',
    // build-hap.sh rewrites these from the workspace Cargo.toml (versionName
    // is the crate version, versionCode is derived from it). The values here
    // only apply to an IDE build that bypasses the script.
    versionCode: 1039999,
    versionName: '0.1.3',
    icon: '$media:app_icon',
    label: '$string:app_name',
  },
}
