// Keep the non-visual tray in its own Slint compilation unit. app.slint embeds
// the UI font; compiling a SystemTrayIcon alongside it makes Slint create
// a window adapter just to register that font, which leaks an empty 800x600
// "Slint Window" into Linux task switchers.
export component EvanyaTray inherits SystemTrayIcon {
    in-out property <bool> enabled: false;
    visible: root.enabled;
    // Rust sets the chosen icon's tray image from AppIcon.tray-image, which
    // explains the small size; this compilation unit cannot share globals
    // with app.slint.
    in property <image> image: @image-url("../resources/app-icon/evanya-tray.png");
    // Unread inbox conversations; Rust marks the image when there are some.
    in property <int> unread: 0;
    icon: root.image;
    title: @tr("Evanya");
    tooltip: root.unread > 0
        ? @tr("Evanya: {} unread", root.unread)
        : @tr("Evanya");

    callback show_window();
    callback quit_app();

    clicked => { root.show_window(); }

    Menu {
        MenuItem {
            title: @tr("Show Evanya");
            activated => { root.show_window(); }
        }
        MenuItem {
            title: @tr("Quit");
            activated => { root.quit_app(); }
        }
    }
}
