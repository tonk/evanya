// A compact desktop type ramp based on the font size reported by the OS.
// Keeping these values relative means platform accessibility text settings
// scale the application instead of being bypassed by fixed pixel sizes.
export global TypeScale {
    // Reserved for short, icon-supported labels such as the desktop product
    // rail. At the 12px fallback base this resolves to the 10px macOS minimum.
    out property <relative-font-size> micro: 0.83rem;
    out property <relative-font-size> caption: 1rem;
    out property <relative-font-size> secondary: 1.08rem;
    out property <relative-font-size> body: 1.17rem;
    out property <relative-font-size> body-large: 1.25rem;
    out property <relative-font-size> subtitle: 1.33rem;
    out property <relative-font-size> heading-small: 1.42rem;
    out property <relative-font-size> heading: 1.5rem;
    out property <relative-font-size> heading-large: 1.58rem;
    out property <relative-font-size> title-small: 1.66rem;
    out property <relative-font-size> title: 1.75rem;
    out property <relative-font-size> title-large: 1.83rem;
    out property <relative-font-size> display: 2rem;
    out property <relative-font-size> display-large: 2.08rem;
}

// The font and size of each part of the workspace, as chosen in Settings.
// A scale multiplies the type ramp, so headings and captions keep their
// proportions and the platform's text size still applies.
export global AreaFonts {
    in-out property <string> sidebar-family: "Google Sans Flex";
    in-out property <float> sidebar-scale: 1;
    in-out property <string> list-family: "Google Sans Flex";
    in-out property <float> list-scale: 1;
    in-out property <string> reader-family: "Google Sans Flex";
    in-out property <float> reader-scale: 1;
    in-out property <string> calendar-family: "Google Sans Flex";
    in-out property <float> calendar-scale: 1;
    in-out property <string> contacts-family: "Google Sans Flex";
    in-out property <float> contacts-scale: 1;
    in-out property <string> files-family: "Google Sans Flex";
    in-out property <float> files-scale: 1;
    in-out property <string> composer-family: "Google Sans Flex";
    in-out property <float> composer-scale: 1;
}
